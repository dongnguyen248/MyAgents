# Copy this file to ".env" (same folder) and fill in your values.
# The API demo loads ".env" at startup; real environment variables win.
# ".env" is git-ignored — never commit real secrets.

# --- MariaDB store (python -m asf.api.demo --mariadb) ---
# Only the password is required; the rest default to a local MariaDB
# with the account created as:
#   CREATE USER 'asf'@'localhost' IDENTIFIED BY '...';
#   GRANT ALL PRIVILEGES ON asf.* TO 'asf'@'localhost';
ASF_MARIADB_PASSWORD=
# ASF_MARIADB_HOST=127.0.0.1
# ASF_MARIADB_PORT=3306
# ASF_MARIADB_USER=asf
# ASF_MARIADB_DATABASE=asf

# --- Hosting tokens (Phase 8, only for projects linked to a repo) ---
# ASF_GITHUB_TOKEN=
# ASF_GITLAB_TOKEN=
