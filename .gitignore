# Environment and secrets
.env
.env.*
*.secret
*.pem
secrets/
config/*.local.yaml

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.venv/

# Testing and linting caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
# Runtime artifacts (repo root only: nested artifacts/ directories
# inside src/ or tests/ are source, not output)
/artifacts/
.asf-evidence/
# Runtime data (the default SQLite run database lives in data/)
data/
# Stray agent output from pre-worktree local runs: a calculator.py
# at the REPO ROOT can only be a run artifact (real code lives in
# src/; the calculator benchmark case is harness/evaluation/cases/)
/calculator.py
*.log
.DS_Store

# Node and editor
node_modules/
.idea/
.vscode/

!.env.example
