# Environment and secrets
.env
.env.*
*.secret
*.pem
/data/hosting-tokens.json
/data/model-settings.json
/projects/*.yaml
/projects/*.yml
secrets/
config/*.local.yaml

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.venv/

# Testing and linting caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
# Runtime artifacts (repo root only: nested artifacts/ directories
# inside src/ or tests/ are source, not output)
/artifacts/
.asf-evidence/
*.log
# Runtime data (the default SQLite run database lives in data/)
data/

# Node and editor
node_modules/
.idea/
.vscode/
.DS_Store

!.env.example
